---
const target = `${import.meta.env.BASE_URL}zh-cn/real-world-development/cli/9-cli-power-tools/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>正在跳转到 GitHub Copilot CLI 中的斜杠命令</title>
  </head>
  <body>
    <a href={target}>本课程已更改位置。请继续学习 GitHub Copilot CLI 中的斜杠命令。</a>
  </body>
</html>
